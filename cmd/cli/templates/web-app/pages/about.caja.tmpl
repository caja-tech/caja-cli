import * from "@caja/siriguela"
import * from "@caja/ui"

# A second page, so the site has somewhere to navigate to. Every page is a
# module under pages/ that exports `page`: main.caja imports it, adds it to
# the site list, wraps it in the shared layout and writes it to dist/.
# Nothing in a page file writes a file itself — that is main.caja's job,
# and keeping it there is what lets `caja run` still execute a page module
# on its own for a quick check.
#
# Two wildcard imports: @caja/siriguela for everything themed, and
# @caja/ui for the structural layer underneath it (here, definePage and the
# Page type). siriguela does not re-export ui, so anything structural comes
# from ui directly.

let hero = heroPanel(
	"assets/siriguela.svg",
	"The siriguela mark",
	"About {{.Name}}",
	"A static site generated by Caja, styled with siriguela, built from the files in this folder."
)

let layoutGuide = guideSection("How this project is laid out", [
	"main.caja — the site builder. It lists every page, hands each one to renderPage for the shared layout, and writes dist/*.html and dist/style.css with doc.write.",
	"pages/ — one .caja file per page. Each exports page, a definePage(title, path, content); add it to the site list in main.caja and it gets a navigation link.",
	"assets/ — images, documents, anything a page references. Copied to dist/assets/ on every build (recreated from scratch each time), so reference files as assets/<name>. The mark above is assets/siriguela.svg.",
	"dist/ — the generated site. Never edit it by hand; caja build and caja serve rewrite it."
])

let stylingGuide = stack() {
	subheading("Where the styling comes from")
	paragraph("Hover the box above — it lifts. That shadow is a hover state, which no inline style can express, so it lives in the theme's stylesheet rather than on the element. siriguela owns that stylesheet: main.caja writes siteStylesheet() to dist/style.css and never writes a line of CSS itself.")
	codeSample("doc.write(\"dist/style.css\", siteStylesheet())")
	paragraph("The home page's Theme tab lists the palette those rules are built from.")
}

let content = pageContent() {
	hero
	layoutGuide
	stylingGuide
}

let page = definePage(title: "About", path: "about.html", content: content)
