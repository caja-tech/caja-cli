import * from "@caja/siriguela"
import * from "@caja/ui"
import doc
import array
import "pages/index" as home
import "pages/about" as about

# main.caja is the site builder — the one file in this project that writes
# anything. Each page under pages/ is a module exporting `page` (a Page:
# title, output path, content); this file lists them and writes them out.
#
# `caja build` compiles this file to a native binary and runs it once from
# the project folder — which is why every path below is relative
# ("dist/...") — and then copies assets/ into dist/assets/. `caja serve`
# does the same and serves dist/.
#
# To add a page: create pages/name.caja exporting `page`, import it here,
# and append it to `site`. The navigation, the shared layout and the
# writer all pick it up from that one list.
#
# Two libraries, both wildcard-imported so every name reads bare.
# @caja/ui is the structural layer: the View tree, and the site model this
# file is built on (Page, definePage, navLinks). @caja/siriguela is the
# theme on top of it: renderPage wraps a page in the shared chrome
# (navigation, footer) and a full HTML document, and siteStylesheet is the
# theme's whole CSS. There is no hand-written HTML or CSS in this project.
#
# Spell each import identically in every file (here and in each page). The
# specifier is the module cache key; two spellings would compile the same
# library twice, with two incompatible Page types.

let site: [Page] = [home.page, about.page]

# A const, not a let: writeSite is a const fn, and a module-level function
# may read a module-level const but never a module-level let.
const footerNote = "Built with siriguela. Every page under pages/ in {{.Name}} is written by the same loop in main.caja."

# One doc.write per Page. Recursion is how Caja loops; this tail call
# compiles to a plain loop.
const writeSite = fn(remaining: [Page], all: [Page]) -> Nothing {
	if (array.len(remaining) == 0) {
		return
	}
	let current = array.head(remaining)
	doc.write("dist/${current.path}", renderPage(current, all, footerNote, "style.css"))
	return writeSite(array.tail(remaining), all)
}

writeSite(site, site)
doc.write("dist/style.css", siteStylesheet())
