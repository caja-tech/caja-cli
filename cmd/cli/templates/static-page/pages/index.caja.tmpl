import * from "@caja/siriguela"
import * from "@caja/ui"
import * from "@caja/js"
import js

# The home page: a working reference for @caja/siriguela — every component
# documented below is also used to render the documentation you are reading.
# It is an ordinary page module: it exports `page` at the bottom and never
# writes a file; main.caja wraps it in the site layout and writes it. Edit
# it freely, or replace it.
#
# Both imports are wildcards, which brings every component, type and palette
# constant into scope unqualified — the compose-style DSL this page is
# written in. @caja/siriguela is the theme; @caja/ui is the structural layer
# it is built on, imported here for `definePage` and `Page`. siriguela does
# not re-export ui, so anything structural comes from ui directly.
#
# Most of the interactive demos below are CSS-only or native HTML, which is
# why they work in a static page with no JavaScript at all. The one
# exception is the "Interactivity" section, which uses js.raw to attach
# real JavaScript — see it for the difference between the two kinds of
# event handler and why a static page can only use one of them.

# ---------------------------------------------------------------------
# 1. What siriguela is
# ---------------------------------------------------------------------

let intro = docSection("what", "What is siriguela?", [
	leadText("The default theme for Caja's UI libraries. It gives you a palette, a set of themed components, the page and site model, and the stylesheet that ties them together — so a project gets a coherent look without writing any CSS."),
	paragraph("siriguela is one of two packages. @caja/ui is the structural layer: it builds a View tree — a tag, its attributes, its inline styles, its children — and renders that tree to an HTML string at build time, or to live DOM in a browser. It has no opinion about how anything looks. siriguela is that opinion."),
	paragraph("A component is a function that returns a View. Everything below is one, which is why this page can document siriguela almost entirely in siriguela."),
	paragraph("It is named after the fruit: deep plum skin, amber flesh, olive leaf. Those are the palette's colors.")
])

# ---------------------------------------------------------------------
# 2. Install
# ---------------------------------------------------------------------

let install = docSection("install", "Install", [
	paragraph("Two packages: the theme, and the structural layer it is built on. siriguela declares @caja/ui as a dependency, but this project imports it directly too — for Page, definePage and the event handlers — so both are installed."),
	codeSample("npm install @caja/siriguela @caja/ui"),
	subheading("Importing"),
	paragraph("Wildcard, which is what this page uses — every name from both packages becomes available bare. Their export surfaces are disjoint, so there is nothing to collide:"),
	codeSample("import * from \"@caja/siriguela\"\nimport * from \"@caja/ui\"\n\nlet hello = paragraph(\"Hello\")\nlet aBox = view(HTMLElement.Div)"),
	paragraph("Qualified, which names where every call comes from at the cost of the prefix:"),
	codeSample("import \"@caja/siriguela\" as theme\nimport \"@caja/ui\" as ui\n\nlet hello = theme.paragraph(\"Hello\")\nlet aBox = ui.view(ui.HTMLElement.Div)"),
	mutedText("siriguela does not forward ui's catalog: every name it exports is its own. That is deliberate — a theme that forwarded a structural catalog would make your code depend on which names happen to be forwarded, and would blur the line the two packages exist to draw. It is also why you import ui yourself rather than reaching through the theme for it."),
	subheading("A whole page"),
	codeSample("import * from \"@caja/siriguela\"\nimport * from \"@caja/ui\"\nimport doc\n\nlet content = pageContent() {\n\tpageHeading(\"Hello\")\n\tparagraph(\"Welcome.\")\n}\n\nlet home = definePage(title: \"Home\", path: \"index.html\", content: content)\nlet site: [Page] = [home]\n\ndoc.write(\"dist/index.html\", renderPage(home, site, \"A footer note.\", \"style.css\"))\ndoc.write(\"dist/style.css\", siteStylesheet())")
])

