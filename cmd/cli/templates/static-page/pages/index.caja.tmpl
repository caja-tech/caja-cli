import "@caja/siriguela" as ui

# The home page: a working reference for siriguela itself, built with
# nothing but siriguela — every component documented below is also used to
# render the documentation you are reading. It is an ordinary page module:
# it exports `page` at the bottom and never writes a file; main.caja wraps
# it in the site layout and writes it. Edit it freely, or replace it.
#
# Two things worth knowing before you start cutting it down:
#   - Nothing here attaches an event handler. A static-page build has no
#     JS runtime, so renderToString() drops handlers (and warns at build
#     time). Every interactive demo below is CSS-only or native HTML.
#   - The site's stylesheet lives at the bottom of main.caja. siriguela
#     emits inline styles; anything a style attribute cannot express — a
#     hover, a checked sibling, a pseudo-element — needs a real selector,
#     either hand-written there or defined in Caja with class() (see the
#     Site tab of the reference below).
#
# Helpers here are `const fn`s and read only other consts and the ui
# module — a module-level function may never read a module-level `let`.

# ---------------------------------------------------------------------
# Small helpers, composed from siriguela primitives like any other
# component. These are what the page's own layout is built from.
# ---------------------------------------------------------------------

const docSection = fn(anchor: String, title: String, children: [ui.View]) -> ui.View {
	let body = ui.column(children) |> ui.gap("16px")
	let sec = ui.section() {
		ui.heading(2, title)
		body
	}
	return sec |> ui.elementId(anchor) |> ui.className("doc-section")
}

# componentDoc is the repeated unit of this page: the function signature,
# one line of prose, a copy-pasteable sample, and the live result of that
# sample rendered right underneath it.
const componentDoc = fn(names: String, summary: String, sample: String, demo: ui.View) -> ui.View {
	let demoBox = ui.box(demo) |> ui.className("demo")
	let entry = ui.column() {
		ui.code(names) |> ui.className("sig")
		ui.muted(summary)
		ui.codeBlock(sample)
		demoBox
	}
	return entry |> ui.className("component") |> ui.gap("10px")
}

const tocLink = fn(anchor: String, text: String) -> ui.View {
	return ui.listItem("") |> ui.addChild(ui.link("#${anchor}", text))
}

const paletteRow = fn(name: String, hex: String) -> ui.View {
	let swatch = ui.el("span") |> ui.className("swatch") |> ui.backgroundColor(hex)
	return ui.tableRow() {
		ui.tableCell("") |> ui.addChild(swatch)
		ui.tableCell("") |> ui.addChild(ui.code(name))
		ui.tableCell(hex)
	}
}

const modifierRow = fn(group: String, names: String) -> ui.View {
	return ui.tableRow() {
		ui.tableCell(group)
		ui.tableCell("") |> ui.addChild(ui.code(names))
	}
}

# ---------------------------------------------------------------------
# 1. What siriguela is
# ---------------------------------------------------------------------

let intro = docSection("what", "What is siriguela?", [
	ui.lead("A renderer-agnostic UI component DSL for Caja. Describe an interface once as a View tree; render that same tree to an HTML string at build time, or mount it as live DOM in a browser."),
	ui.text("A View is plain data: a tag, its attributes, its inline styles, its children. Building one never touches a DOM and never writes a string — only the two terminals do that, by walking the same tree two different ways. That is the entire model. There is no virtual DOM, no reactive runtime, and the library itself emits no JavaScript at all."),
	ui.text("A component is a function that returns a View. A modifier is a function that takes a View and returns a View. Everything on this page is one or the other, which is why the page can document siriguela using only siriguela."),
	ui.text("It is named after the fruit: deep plum skin, amber flesh, olive leaf. Those are the default theme's colors.")
])

# ---------------------------------------------------------------------
# 2. Install and first page
# ---------------------------------------------------------------------

let install = docSection("install", "Install", [
	ui.text("A static-page project needs only this package. Importing it (and never @caja/siriguela-dom) is what keeps caja build producing a plain native binary rather than wasm."),
	ui.codeBlock("npm install @caja/siriguela"),
	ui.heading(3, "Two ways to import"),
	ui.text("Qualified, which is what this page uses — every call visibly says where it came from:"),
	ui.codeBlock("import \"@caja/siriguela\" as ui\n\nlet hello = ui.text(\"Hello\")"),
	ui.text("Or named, which drops the prefix and reads closer to a dedicated language:"),
	ui.codeBlock("import { column, text, primaryButton } from \"@caja/siriguela\"\n\nlet hello = text(\"Hello\")"),
	ui.muted("Named imports bring in values only. If a function signature of yours needs to name the View type, keep a qualified import alongside and write ui.View."),
	ui.heading(3, "A whole page"),
	ui.codeBlock("import \"@caja/siriguela\" as ui\nimport doc\n\nlet body = ui.column() {\n\tui.pageHeading(\"Hello\")\n\tui.text(\"Welcome.\")\n}\n\ndoc.write(\"dist/index.html\", ui.htmlDocument(\"Hello\", \"style.css\", [body]))")
])

# ---------------------------------------------------------------------
# 3. Core concepts
# ---------------------------------------------------------------------

let concepts = docSection("concepts", "Core concepts", [
	ui.heading(3, "Components are just functions"),
	ui.text("Call one, get a View. Nest them by passing Views as children. Nothing is registered, declared or configured anywhere."),
	ui.codeBlock("let greeting = ui.column([\n\tui.heading(1, \"Hello\"),\n\tui.text(\"Welcome.\")\n])"),

	ui.heading(3, "Modifiers pipe"),
	ui.text("Every modifier has the same shape: View in, View out. The pipe operator chains them, so styling reads top to bottom in the order it applies."),
	ui.codeBlock("let boxed = ui.text(\"Careful\")\n\t|> ui.padding(\"12px 16px\")\n\t|> ui.backgroundColor(\"#FBF3E6\")\n\t|> ui.rounded(\"6px\")"),
	ui.box(ui.text("Careful") |> ui.padding("12px 16px") |> ui.backgroundColor("#FBF3E6") |> ui.rounded("6px")) |> ui.className("demo"),

	ui.heading(3, "Blocks instead of arrays"),
	ui.text("Any component whose last parameter is a list of Views accepts a trailing block, so the brackets and commas disappear. The two forms below compile to exactly the same call."),
	ui.codeBlock("ui.column([ui.text(\"a\"), ui.text(\"b\")])\n\nui.column() {\n\tui.text(\"a\")\n\ttext(\"b\")\n}"),
	ui.muted("The parentheses before the block are required. Only plain expressions go inside it — no let, no if. Build anything computed as a list first, then pass it."),

	ui.heading(3, "Two terminals"),
	ui.text("renderToString walks the tree into an HTML string, which is how this page was generated. mount, from the companion @caja/siriguela-dom package, walks the same tree into live DOM nodes and attaches any event handlers. Components never know which one will consume them."),
	ui.codeBlock("let html = ui.renderToString(view)\n\ndom.mount(view, browser.getElementById(\"app\"))")
])

