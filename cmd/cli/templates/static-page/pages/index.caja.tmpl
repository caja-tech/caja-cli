			ui.themedAlert(ui.Variant.Danger, "Something broke."),
			ui.row([
				ui.themedBadge(ui.Variant.Success, "Active"),
				ui.themedBadge(ui.Variant.Danger, "Failed")
			]) |> ui.gap("8px")
		])
	)
	componentDoc(
		"alert(children)",
		"The unstyled structural version, if you would rather bring your own colours.",
		"ui.alert() {\n\tui.text(\"Plain alert.\")\n}",
		ui.alert([ui.text("Plain alert.")]) |> ui.padding("12px") |> ui.border("1px solid #ddd") |> ui.rounded("6px")
	)
	ui.heading(3, "Your own theme")
	ui.text("A theme is a module that imports siriguela and exports its own wrappers. Note the palette constant is a const, not a let: a function may read an outer const, never an outer let.")
	ui.codeBlock("import \"@caja/siriguela\" as ui\n\nconst brandPrimary = \"#1D7A85\"\n\nconst brandButton = fn(label: String) -> ui.View {\n\treturn ui.button(label)\n\t\t|> ui.backgroundColor(brandPrimary)\n\t\t|> ui.color(\"#FFFFFF\")\n\t\t|> ui.rounded(\"6px\")\n\t\t|> ui.padding(\"8px 16px\")\n}")
}

# The Site tab's live class demo. Defined at module level so the tab can
