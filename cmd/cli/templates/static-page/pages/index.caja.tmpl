let sitePanel = ui.column() {
	ui.text("A site is more than one page. You are reading pages/index.caja of {{.Name}}; the About link in the header goes to pages/about.caja. Both are ordinary modules that export a Page, and main.caja is a short loop that wraps each one in the shared layout and writes it. siriguela only builds pages — writing them is the doc module's job, and it stays in main.caja on purpose (a library that wrote files would make every program importing it un-runnable with caja run).")
	componentDoc(
		"definePage(title, path, content) / navLinks(pages, currentPath)",
		"A Page is a title, an output path (also the href other pages use) and a content View. Named arguments (title:, path:, content:) disambiguate the two adjacent strings — a plain positional call reads fine once, but a typo swapping title and path is a String-shaped value in the wrong String-typed slot, which the analyzer can't catch positionally. navLinks renders one link per page and marks the current one with aria-current='page' — a stylesheet hook as much as an accessibility one.",
		"let home = ui.definePage(title: \"Home\", path: \"index.html\", content: homeContent)\nlet about = ui.definePage(title: \"About\", path: \"about.html\", content: aboutContent)\n\nui.navLinks([home, about], \"about.html\")",
		ui.navLinks([ui.definePage(title: "Home", path: "index.html", content: ui.text("")), ui.definePage(title: "About", path: "about.html", content: ui.text(""))], "about.html") |> ui.className("site-nav")
	)
	componentDoc(
		"htmlDocument(title, stylesheetHref, body)",
		"Wraps a body in a complete document — html, head with charset/viewport/title/stylesheet, body — and returns the String, doctype included. body is the last parameter, so a trailing block works.",
		"ui.htmlDocument(\"Hello\", \"style.css\") {\n\tui.text(\"hi\")\n}",
		ui.codeBlock(ui.htmlDocument("Hello", "style.css", [ui.text("hi")]))
	)
	componentDoc(
		"styles() / class(name, template) / variant(cls, pseudo, template)",
		"A CSS class defined in Caja. styles() is an empty View that exists only to collect modifiers; class() lifts what they wrote into a Class; variant() adds a pseudo-state rule. Hover the box below — its hover shadow is a Caja-defined variant, something no inline style could express.",
		"let demoCard = ui.class(\"demo-card\", ui.styles()\n\t\t|> ui.padding(\"16px\")\n\t\t|> ui.rounded(\"10px\")\n\t\t|> ui.backgroundColor(ui.siriguelaCream))\n\t|> ui.variant(\"hover\", ui.styles() |> ui.boxShadow(\"0 8px 24px #7a204833\"))",
		ui.column([ui.classStylesheet([demoCard]), ui.box(ui.text("Hover me")) |> ui.withClass(demoCard)])
	)
	componentDoc(
		"withClass(view, cls) / withClasses(view, classes) / classCss(classes) / classStylesheet(classes)",
		"Apply a Class to a View (withClasses combines several into one class attribute), and emit the rules — as a String for a .css file written with doc.write, or as a style element to drop straight into a page.",
		"ui.box(content) |> ui.withClasses([demoCard, other])\n\ndoc.write(\"dist/style.css\", ui.classCss([demoCard, other]))\n\nui.classStylesheet([demoCard])",
		ui.codeBlock(ui.classCss([demoCard]))
	)
	componentDoc(
		"rule(selector, template) / media(query, rules) / stylesheet(rules, classes, queries)",
		"A Class only covers one class name plus its pseudo-states. Real stylesheets also need element selectors, comma-grouped selectors, descendant/child/sibling combinators, attribute selectors and media queries — none of which have a fixed set of properties to hang a modifier chain off of. A Rule keeps the type-checked half (declarations, via the same modifier chain) and takes the selector as plain, unchecked text, same as a selector in any CSS-in-language library. stylesheet renders rules, then classes, then media queries into one String, in the cascade order a hand-written stylesheet would use — this project's main.caja calls it once to build the whole of dist/style.css.",
		"let rules: [ui.Rule] = [\n\tui.rule(\"h1, h2, h3\", ui.styles() |> ui.lineHeight(\"1.25\")),\n\tui.rule(\".site-nav a[aria-current=page]\", ui.styles() |> ui.color(\"#7A2048\"))\n]\nlet queries: [ui.MediaQuery] = [\n\tui.media(\"(max-width: 640px)\", [ui.rule(\".page\", ui.styles() |> ui.gap(\"28px\"))])\n]\n\ndoc.write(\"dist/style.css\", ui.stylesheet(rules, [demoCard], queries))",
		ui.codeBlock(ui.rulesCss([ui.rule("h1, h2, h3", ui.styles() |> ui.lineHeight("1.25")), ui.rule(".site-nav a[aria-current=page]", ui.styles() |> ui.color("#7A2048"))]))
	)
	ui.heading(3, "How main.caja assembles the site")
	ui.text("The whole site builder is a page list, a layout function and a recursive writer. Add a page module, import it, add it to the list — that is the entire workflow.")
	ui.codeBlock("import \"pages/index\" as home\nimport \"pages/about\" as about\n\nlet site: [ui.Page] = [home.page, about.page]\n\nconst writeSite = fn(remaining: [ui.Page], all: [ui.Page]) -> Nothing {\n\tif (array.len(remaining) == 0) {\n\t\treturn\n\t}\n\tlet current = array.head(remaining)\n\tdoc.write(\"dist/\${current.path}\", ui.htmlDocument(current.title, \"style.css\", layout(current, all)))\n\treturn writeSite(array.tail(remaining), all)\n}\n\nwriteSite(site, site)")
}

