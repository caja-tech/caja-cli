import "@caja/siriguela" as ui

# A second page, so the site has somewhere to navigate to. Every page is a
# module under pages/ that exports `page`: main.caja imports it, adds it to
# the site list, wraps it in the shared layout and writes it to dist/.
# Nothing in a page file writes a file itself — that is main.caja's job,
# and keeping it there is what lets `caja run` still execute a page module
# on its own for a quick check.

# A CSS class defined in Caja. The same modifier chain that styles a View
# builds the class, so a misspelled property is still a compile-time
# error; the hover variant is what an inline style could never express.
# main.caja reads this as about.heroClass and emits it into dist/style.css
# — which is why it is a top-level binding, not private.
let heroClass = ui.class("hero", ui.styles()
		|> ui.padding("24px")
		|> ui.rounded("12px")
		|> ui.backgroundColor(ui.siriguelaCream)
		|> ui.transition("box-shadow 0.2s ease"))
	|> ui.variant("hover", ui.styles() |> ui.boxShadow("0 8px 24px #7a204833"))

let hero = ui.row() {
	ui.image("assets/siriguela.svg", "The siriguela mark") |> ui.width("96px") |> ui.height("96px")
	ui.column() {
		ui.heading(2, "About {{.Name}}")
		ui.lead("A static site generated by Caja, styled with siriguela, built from the files in this folder.")
	}
} |> ui.gap("20px") |> ui.alignItems("center") |> ui.withClass(heroClass)

let layoutGuide = ui.column() {
	ui.heading(3, "How this project is laid out")
	ui.unorderedList() {
		ui.listItem("main.caja — the site builder. It imports every page, wraps each one in the shared layout and navigation, and writes dist/*.html and dist/style.css with doc.write.")
		ui.listItem("pages/ — one .caja file per page. Each exports page, a ui.definePage(title, path, content); add it to the site list in main.caja and it gets a navigation link.")
		ui.listItem("assets/ — images, documents, anything a page references. Copied to dist/assets/ on every build (recreated from scratch each time), so reference files as assets/<name>. The mark above is assets/siriguela.svg.")
		ui.listItem("dist/ — the generated site. Never edit it by hand; caja build and caja serve rewrite it.")
	}
} |> ui.gap("8px")

let classGuide = ui.column() {
	ui.heading(3, "The class styling this box")
	ui.text("Hover the box above. Its base styles and its hover rule are both defined in Caja at the top of this file, and main.caja writes them into style.css alongside the hand-written rules:")
	ui.codeBlock("let heroClass = ui.class(\"hero\", ui.styles()\n\t\t|> ui.padding(\"24px\")\n\t\t|> ui.rounded(\"12px\")\n\t\t|> ui.backgroundColor(ui.siriguelaCream))\n\t|> ui.variant(\"hover\", ui.styles() |> ui.boxShadow(\"0 8px 24px #7a204833\"))\n\nlet hero = ui.row() { ... } |> ui.withClass(heroClass)")
	ui.text("The home page's Site tab documents the whole class API.")
} |> ui.gap("8px")

let content = ui.column() {
	hero
	layoutGuide
	classGuide
} |> ui.gap("32px")

let page = ui.definePage("About", "about.html", content)
