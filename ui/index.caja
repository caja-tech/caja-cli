import array
import string
import log
import * from "@caja/js"
import js

# @caja/ui — the renderer-agnostic building blocks for generating HTML and
# CSS from Caja: the View tree and its types, the view/attr/style
# primitives, the modifier chain, the event-handler surface, the structural
# (unstyled) component catalog, renderToString, the CSS-in-Caja APIs
# (Class/Rule/MediaQuery/Keyframes) and the page/document helpers.
#
# Nothing in this package has an opinion about how anything LOOKS. There
# are no colors, no palette, no spacing scale — every component here emits
# either plain structural markup or only the inline styles its own layout
# semantics require (column sets flex-direction, not a gap you didn't ask
# for). A theme is a separate package built on top of this one:
# @caja/siriguela is the default one, and a custom theme is just another
# module of wrappers over these same functions. A theme composes its own,
# smaller vocabulary out of what is here and exports that — it does not
# forward this catalog, so a theme's consumer never sees these names
# unless they import this package themselves, which is fine and supported.
# That split is the whole reason this package exists: someone who wants
# siriguela's look writes siriguela, and someone who wants to theme from
# scratch imports this package directly and never pulls in a palette they
# intend to replace.
#
# How this file is ordered, and why it matters: primitives first, then
# everything built on them, with the component catalog and the site model
# last. That is not just tidiness — Caja has no forward references between
# separate bindings (only a function may reference its OWN name from inside
# its own body), so the reading order below IS the dependency order. A
# component that needs a Rule has to come after the Rule section; the
# rendering terminal has to come after the escaping helpers it calls.
#
#   1. Enums          — HTMLElement, CSSProperty, DOMEvent
#   2. Core types     — Handler, Attr, Style, View
#   3. Primitives     — view/customView, attr, style, addChild(ren)
#   4. Modifier chain — one pipeable function per CSSProperty, + attributes
#   5. Events         — on(), plus a named wrapper per DOMEvent
#   6. Rendering      — escaping, then renderToString
#   7. CSS in Caja    — Class, Rule, MediaQuery, Keyframes, stylesheet
#   8. Components     — the structural catalog
#   9. Site model     — Page, navLinks, htmlDocument

# ---------------------------------------------------------------------
# 1. Enums
#
# All three exist for one reason: to turn a typo into a compile-time error
# at the call site instead of a silently dead attribute, style or handler.
# They are closed `enum`s, so an enum value widens implicitly to String
# wherever one is expected, but a bare String does NOT narrow back — which
# is what makes view("dvi") or on(v, "clik", h) a real type error rather
# than markup that renders and quietly does nothing.
# ---------------------------------------------------------------------

# HTMLElement is the closed set of tag names view() accepts: the element
# set of the HTML Living Standard, grouped below the way the spec groups
# it. Obsolete elements (<center>, <font>, <marquee>) are deliberately
# absent — a browser still parses them, but nothing new should emit them.
#
# For anything NOT in this list — a web component (<my-widget>), an SVG or
# MathML child (<circle>, <mi>) — use customView(tag: String) below, which
# takes a raw, unchecked String. The enum is the typed front door, not a
# wall: the point is that the common case can't be misspelled, not that
# valid markup becomes unreachable.
#
# Member names never collide with this file's other top-level names, even
# where they look identical (HTMLElement.Style vs `type Style struct`,
# HTMLElement.Option vs option()): an enum's members live in the enum's own
# map, reached only through `HTMLElement.`, and are never registered in the
# module's scope.
enum HTMLElement {
	# Document metadata
	Html = "html",
	Head = "head",
	Title = "title",
	Base = "base",
	Link = "link",
	Meta = "meta",
	Style = "style",
	# Sections
	Body = "body",
	Article = "article",
	Section = "section",
	Nav = "nav",
	Aside = "aside",
	H1 = "h1",
	H2 = "h2",
	H3 = "h3",
	H4 = "h4",
	H5 = "h5",
	H6 = "h6",
	Hgroup = "hgroup",
	Header = "header",
	Footer = "footer",
	Address = "address",
	# Grouping content
	P = "p",
	Hr = "hr",
	Pre = "pre",
	Blockquote = "blockquote",
	Ol = "ol",
	Ul = "ul",
	Menu = "menu",
	Li = "li",
	Dl = "dl",
	Dt = "dt",
	Dd = "dd",
	Figure = "figure",
	Figcaption = "figcaption",
	Main = "main",
	Search = "search",
	Div = "div",
	# Text-level semantics
	A = "a",
	Em = "em",
	Strong = "strong",
	Small = "small",
	S = "s",
	Cite = "cite",
	Q = "q",
	Dfn = "dfn",
	Abbr = "abbr",
	Ruby = "ruby",
	Rt = "rt",
	Rp = "rp",
	Data = "data",
	Time = "time",
	Code = "code",
	Var = "var",
	Samp = "samp",
	Kbd = "kbd",
	Sub = "sub",
	Sup = "sup",
	I = "i",
	B = "b",
	U = "u",
	Mark = "mark",
	Bdi = "bdi",
	Bdo = "bdo",
	Span = "span",
	Br = "br",
	Wbr = "wbr",
	# Edits
	Ins = "ins",
	Del = "del",
	# Embedded content
	Picture = "picture",
	Source = "source",
	Img = "img",
	Iframe = "iframe",
	Embed = "embed",
	Object = "object",
	Video = "video",
	Audio = "audio",
	Track = "track",
	Map = "map",
	Area = "area",
	# Tabular data
	Table = "table",
	Caption = "caption",
	Colgroup = "colgroup",
	Col = "col",
	Tbody = "tbody",
	Thead = "thead",
	Tfoot = "tfoot",
	Tr = "tr",
	Td = "td",
	Th = "th",
	# Forms
	Form = "form",
	Label = "label",
	Input = "input",
	Button = "button",
	Select = "select",
	Datalist = "datalist",
	Optgroup = "optgroup",
	Option = "option",
	Textarea = "textarea",
	Output = "output",
	Progress = "progress",
	Meter = "meter",
	Fieldset = "fieldset",
	Legend = "legend",
	# Interactive elements
	Details = "details",
	Summary = "summary",
	Dialog = "dialog",
	# Scripting
	Script = "script",
	Noscript = "noscript",
	Template = "template",
	Slot = "slot",
	Canvas = "canvas",
}

# CSSProperty is the closed set of style property names style()/the
# modifier functions below accept. If a property you need doesn't have a
# member yet, add one (and a matching wrapper in the modifier chain)
# directly here, following the existing pattern.
enum CSSProperty {
	Padding = "padding",
	PaddingTop = "padding-top",
	PaddingBottom = "padding-bottom",
	Margin = "margin",
	MarginTop = "margin-top",
	Background = "background",
	BackgroundColor = "background-color",
	Color = "color",
	FontSize = "font-size",
	FontFamily = "font-family",
	BorderRadius = "border-radius",
	Display = "display",
	FlexDirection = "flex-direction",
	FlexBasis = "flex-basis",
	Width = "width",
	Height = "height",
	MinWidth = "min-width",
	MaxWidth = "max-width",
	MinHeight = "min-height",
	MaxHeight = "max-height",
	Gap = "gap",
	AlignItems = "align-items",
	JustifyContent = "justify-content",
	AlignSelf = "align-self",
	FlexGrow = "flex-grow",
	FlexShrink = "flex-shrink",
	FlexWrap = "flex-wrap",
	GridTemplateColumns = "grid-template-columns",
	GridTemplateRows = "grid-template-rows",
	FontWeight = "font-weight",
	LineHeight = "line-height",
	TextAlign = "text-align",
	LetterSpacing = "letter-spacing",
	TextDecoration = "text-decoration",
	WhiteSpace = "white-space",
	TextTransform = "text-transform",
	Border = "border",
	BorderWidth = "border-width",
	BorderColor = "border-color",
	BorderStyle = "border-style",
	BorderTop = "border-top",
	BorderBottom = "border-bottom",
	BorderCollapse = "border-collapse",
	BoxShadow = "box-shadow",
	Opacity = "opacity",
	Cursor = "cursor",
	PointerEvents = "pointer-events",
	Overflow = "overflow",
	OverflowX = "overflow-x",
	VerticalAlign = "vertical-align",
	Position = "position",
	Top = "top",
	Right = "right",
	Bottom = "bottom",
	Left = "left",
	ZIndex = "z-index",
	Transition = "transition",
	Transform = "transform",
	Content = "content",
	BoxSizing = "box-sizing",
	AspectRatio = "aspect-ratio",
	Animation = "animation",
}

# DOMEvent is the closed set of event names on() accepts — the same
# mechanism as CSSProperty, one layer over. Member names are spelled out
# even where the wire name is abbreviated (DoubleClick = "dblclick").
#
# Public, and the single definition of the event set for the whole
# ecosystem: the closed set of events the onX handlers below accept.
#
# Nothing in this package's public API takes a DOMEvent — on() is private,
# and the named onX wrappers are the surface — so a consumer rarely names
# the type. It is exported anyway, so one can be passed around or annotated
# by code that builds handlers generically.
#
# Element events only. Window/document-scoped events (beforeunload,
# DOMContentLoaded, popstate, hashchange, visibilitychange, online/offline)
# are deliberately absent: on() attaches to the element a View becomes, so
# one of those could never fire from an element attribute. Attach those
# yourself with a scriptBlock calling addEventListener.
enum DOMEvent {
	# Mouse
	Click = "click",
	DoubleClick = "dblclick",
	AuxClick = "auxclick",
	ContextMenu = "contextmenu",
	MouseDown = "mousedown",
	MouseUp = "mouseup",
	MouseEnter = "mouseenter",
	MouseLeave = "mouseleave",
	MouseOver = "mouseover",
	MouseOut = "mouseout",
	MouseMove = "mousemove",
	Wheel = "wheel",
	# Pointer
	PointerDown = "pointerdown",
	PointerUp = "pointerup",
	PointerMove = "pointermove",
	PointerEnter = "pointerenter",
	PointerLeave = "pointerleave",
	PointerOver = "pointerover",
	PointerOut = "pointerout",
	PointerCancel = "pointercancel",
	GotPointerCapture = "gotpointercapture",
	LostPointerCapture = "lostpointercapture",
	# Touch
	TouchStart = "touchstart",
	TouchMove = "touchmove",
	TouchEnd = "touchend",
	TouchCancel = "touchcancel",
	# Keyboard
	KeyDown = "keydown",
	KeyUp = "keyup",
	KeyPress = "keypress",
	# Form and input
	Input = "input",
	BeforeInput = "beforeinput",
	Change = "change",
	Submit = "submit",
	Reset = "reset",
	Invalid = "invalid",
	Select = "select",
	Search = "search",
	# Focus
	Focus = "focus",
	Blur = "blur",
	FocusIn = "focusin",
	FocusOut = "focusout",
	# Clipboard
	Copy = "copy",
	Cut = "cut",
	Paste = "paste",
	# Drag and drop
	DragStart = "dragstart",
	Drag = "drag",
	DragEnter = "dragenter",
	DragOver = "dragover",
	DragLeave = "dragleave",
	Drop = "drop",
	DragEnd = "dragend",
	# Scrolling
	Scroll = "scroll",
	ScrollEnd = "scrollend",
	# Loading
	Load = "load",
	Error = "error",
	Abort = "abort",
	# Disclosure and dialog
	Toggle = "toggle",
	BeforeToggle = "beforetoggle",
	Close = "close",
	Cancel = "cancel",
	# Media
	Play = "play",
	Playing = "playing",
	Pause = "pause",
	Ended = "ended",
	VolumeChange = "volumechange",
	TimeUpdate = "timeupdate",
	RateChange = "ratechange",
	DurationChange = "durationchange",
	CanPlay = "canplay",
	CanPlayThrough = "canplaythrough",
	LoadedData = "loadeddata",
	LoadedMetadata = "loadedmetadata",
	LoadStart = "loadstart",
	Progress = "progress",
	Seeked = "seeked",
	Seeking = "seeking",
	Stalled = "stalled",
	Suspend = "suspend",
	Waiting = "waiting",
	Emptied = "emptied",
	CueChange = "cuechange",
	# Animation
	AnimationStart = "animationstart",
	AnimationEnd = "animationend",
	AnimationIteration = "animationiteration",
	AnimationCancel = "animationcancel",
	# Transition
	TransitionRun = "transitionrun",
	TransitionStart = "transitionstart",
	TransitionEnd = "transitionend",
	TransitionCancel = "transitioncancel",
	# Slots
	SlotChange = "slotchange",
}

# ---------------------------------------------------------------------
# 2. Core types
# ---------------------------------------------------------------------

# Handler is one event binding on a View: the event name, and the
# JavaScript to run when it fires.
#
# The script is emitted by renderToString as an inline event attribute
# (onclick='...'), so the browser runs it directly — there is no runtime of
# ours in the page at all. That is the whole model: a Caja program builds
# the page at build time and is gone by the time anyone clicks anything.
#
# `event` is a plain String, not a DOMEvent, even though on() only ever
# puts a DOMEvent in it: an enum value widens to its backing type on the
# way in, and renderToString reads the field straight back out to build the
# attribute name. Typing it as the enum would buy nothing and force a
# narrowing that Caja (correctly) doesn't allow.
#
# `script` is likewise a String rather than a js.Script: by the time it is
# in here it has already been rendered from a @caja/js statement tree, and
# the rest of this file wants to treat it as ordinary text.
type Handler struct {
	event String
	script String
}

# Attr/Style are arrays of name/value pairs, not a map[String]String —
# Caja's "map" standard module has no way to enumerate an arbitrary map's
# entries (no keys/values/entries/forEach, only containsKey/delete), so a
# map-typed attrs/styles field could be written to but never walked by
# renderToString(). Arrays sidestep that entirely (recursion over
# array.head/tail already works, same idiom as everywhere else in this
# file) and, as a real bonus and not just a workaround, give deterministic
# render order — a Go map's iteration order is randomized, which would have
# made renderToString's HTML output nondeterministic between runs.
type Attr struct {
	name String
	value String
}

type Style struct {
	property String
	value String
}

# View is the renderer-agnostic tree every component in this library
# builds: a tag, its attributes and inline styles, its children, and any
# deferred event handlers. Building or styling a View never touches a DOM
# or a string buffer — only renderToString does that, by walking the tree.
#
# children is typed [View] — an array of View's own type. This compiles
# because the analyzer pre-registers a struct's name into the type registry
# before resolving its fields (internal/pipeline/analyzer/analyzer.go's
# struct-definition handling), specifically to support recursive shapes
# like this one.
#
# `tag` is a String, not an HTMLElement, for the same reason Handler.event
# is: view() validates the tag on the way in, customView() deliberately
# doesn't, and both terminals want the raw name back out (renderToString
# interpolates it into the markup). An empty tag
# means "text node" to renderToString — see styles() in section 7, the one
# thing in this file that builds one.
type View struct {
	tag String
	text String
	void Boolean
	attrs [Attr]
	styles [Style]
	children [View]
	handlers [Handler]
}
# ---------------------------------------------------------------------
# 3. Primitives
#
# Everything else in this file — every component, every modifier, the whole
# CSS section — is sugar over these five functions.
#
# Every function here is declared as `let name = fn(...) -> T { ... }`, not
# a bare `fn name(...) { ... }` statement — Caja has no named top-level
# function declaration form; a function is always an anonymous `fn` literal
# bound with `let`/`const`, exactly like every real .caja source in this
# repo already does. A bare `fn name(...)` is a parse error.
#
# Note the parameter name throughout this file: a View-typed parameter is
# always `target`, never `view`, because `view` is now the constructor's
# own name and a parameter would silently shadow it. That shadowing is
# merely harmless today rather than broken (the cross-module resolution bug
# in transpiler.go's resolveIdentifierGoName is fixed), but a modifier that
# later needed to build a View of its own would fail in a confusing way,
# and this file already avoids this class of collision deliberately
# elsewhere (elementId not id, mainEl not main, option's optionLabel).
# ---------------------------------------------------------------------

# rawView is the single struct literal every View in this library comes
# from. Private: callers go through view() (checked) or customView()
# (deliberately unchecked). It also serves styles() in section 7, which
# needs the one View with an empty tag.
#
# children/handlers/attrs/styles are all built via explicitly-typed
# intermediate `let`s rather than bare `[]` literals directly in the struct
# literal. A struct literal field's value is analyzed with no expected-type
# context pushed (unlike a call argument or an explicitly-typed `let`'s
# value), so a bare `[]` there infers as [Any] and fails the field's
# [Attr]/[Style]/[View]/[Handler] type check. An explicitly-typed `let`
# DOES get that context pushed, so the empty array infers correctly before
# it ever reaches the struct literal.
private const rawView = fn(tag: String) -> View {
	let noAttrs: [Attr] = []
	let noStyles: [Style] = []
	let noChildren: [View] = []
	let noHandlers: [Handler] = []
	return View{
		tag: tag, text: "", void: false,
		attrs: noAttrs, styles: noStyles, children: noChildren, handlers: noHandlers,
	}
}

# view builds a View for a standard HTML element. The HTMLElement parameter
# is the whole point: view("dvi") does not compile, because a bare String
# does not narrow to the enum.
const view = fn(tag: HTMLElement) -> View {
	return rawView(tag)
}

# customView is the escape hatch: a raw, unchecked tag name, for a web
# component (<my-widget>), an SVG or MathML child (<circle>, <mi>), or
# anything else HTMLElement doesn't cover. Nothing validates the string, so
# a typo here behaves exactly the way it did before the enum existed — use
# view() unless you actually need this.
const customView = fn(tag: String) -> View {
	return rawView(tag)
}

const attr = fn(target: View, name: String, value: String) -> View {
	# Function parameters are immutable — mutating `target` directly (rather
	# than a rebound local) is a semantic error, "cannot mutate property/
	# index of constant variable". Rebind-then-mutate-then-return is the
	# established pattern for exactly this (see the compiler's own
	# maybeShareValue/copy-on-write handling, written specifically to cover
	# it), not a hand-rolled workaround.
	let v = target
	v.attrs = array.push(v.attrs, Attr{name: name, value: value})
	return v
}

const style = fn(target: View, property: CSSProperty, value: String) -> View {
	let v = target
	v.styles = array.push(v.styles, Style{property: property, value: value})
	return v
}

# addChild inserts a View as a child on another View
const addChild = fn(target: View, child: View) -> View {
	let v = target
	v.children = array.push(v.children, child)
	return v
}

# addChildren folds addChild over an entire [View] array — the first real
# workout for array recursion in this file beyond a straight walk-and-concat
# (mapConcat). A pure tail call (`return addChildren(...)` directly, nothing
# wrapping it), so this compiles as an ordinary self-recursive loop and
# never needed the non-tail-call self-recursion fix in
# internal/pipeline/compiler/transpiler.go's selfReferencingFunctionDecl.
const addChildren = fn(target: View, children: [View]) -> View {
	if (array.len(children) == 0) {
		return target
	}
	let child = array.head(children)
	let rest = array.tail(children)
	return target |> addChild(child) |> addChildren(rest)
}

# ---------------------------------------------------------------------
# 4. Modifier chain
#
# Every function here has the same shape: take a View, merge one entry into
# its styles array via style(), return it. Piped together
# (`v |> padding(...) |> color(...)`), that's the whole customization
# story. None of these need to know which terminal will eventually walk the
# tree — and the same chain also builds a Class or a Rule in section 7, by
# being applied to styles()' empty View instead of a real one.
# ---------------------------------------------------------------------

const padding = fn(target: View, value: String) -> View { return style(target, CSSProperty.Padding, value) }
const paddingTop = fn(target: View, value: String) -> View { return style(target, CSSProperty.PaddingTop, value) }
const paddingBottom = fn(target: View, value: String) -> View { return style(target, CSSProperty.PaddingBottom, value) }
const margin = fn(target: View, value: String) -> View { return style(target, CSSProperty.Margin, value) }
const marginTop = fn(target: View, value: String) -> View { return style(target, CSSProperty.MarginTop, value) }
const background = fn(target: View, value: String) -> View { return style(target, CSSProperty.Background, value) }
const backgroundColor = fn(target: View, value: String) -> View { return style(target, CSSProperty.BackgroundColor, value) }
const color = fn(target: View, value: String) -> View { return style(target, CSSProperty.Color, value) }
const fontSize = fn(target: View, value: String) -> View { return style(target, CSSProperty.FontSize, value) }
const fontFamily = fn(target: View, value: String) -> View { return style(target, CSSProperty.FontFamily, value) }
const rounded = fn(target: View, value: String) -> View { return style(target, CSSProperty.BorderRadius, value) }
const display = fn(target: View, value: String) -> View { return style(target, CSSProperty.Display, value) }
const flexDirection = fn(target: View, value: String) -> View { return style(target, CSSProperty.FlexDirection, value) }
const flexBasis = fn(target: View, value: String) -> View { return style(target, CSSProperty.FlexBasis, value) }
const width = fn(target: View, value: String) -> View { return style(target, CSSProperty.Width, value) }
const height = fn(target: View, value: String) -> View { return style(target, CSSProperty.Height, value) }
const minWidth = fn(target: View, value: String) -> View { return style(target, CSSProperty.MinWidth, value) }
const maxWidth = fn(target: View, value: String) -> View { return style(target, CSSProperty.MaxWidth, value) }
const minHeight = fn(target: View, value: String) -> View { return style(target, CSSProperty.MinHeight, value) }
const maxHeight = fn(target: View, value: String) -> View { return style(target, CSSProperty.MaxHeight, value) }
const gap = fn(target: View, value: String) -> View { return style(target, CSSProperty.Gap, value) }
const alignItems = fn(target: View, value: String) -> View { return style(target, CSSProperty.AlignItems, value) }
const justifyContent = fn(target: View, value: String) -> View { return style(target, CSSProperty.JustifyContent, value) }
const alignSelf = fn(target: View, value: String) -> View { return style(target, CSSProperty.AlignSelf, value) }
const flexGrow = fn(target: View, value: String) -> View { return style(target, CSSProperty.FlexGrow, value) }
const flexShrink = fn(target: View, value: String) -> View { return style(target, CSSProperty.FlexShrink, value) }
const flexWrap = fn(target: View, value: String) -> View { return style(target, CSSProperty.FlexWrap, value) }
const gridTemplateColumns = fn(target: View, value: String) -> View { return style(target, CSSProperty.GridTemplateColumns, value) }
const gridTemplateRows = fn(target: View, value: String) -> View { return style(target, CSSProperty.GridTemplateRows, value) }
const fontWeight = fn(target: View, value: String) -> View { return style(target, CSSProperty.FontWeight, value) }
const lineHeight = fn(target: View, value: String) -> View { return style(target, CSSProperty.LineHeight, value) }
const textAlign = fn(target: View, value: String) -> View { return style(target, CSSProperty.TextAlign, value) }
const letterSpacing = fn(target: View, value: String) -> View { return style(target, CSSProperty.LetterSpacing, value) }
const textDecoration = fn(target: View, value: String) -> View { return style(target, CSSProperty.TextDecoration, value) }
const whiteSpace = fn(target: View, value: String) -> View { return style(target, CSSProperty.WhiteSpace, value) }
const textTransform = fn(target: View, value: String) -> View { return style(target, CSSProperty.TextTransform, value) }
const border = fn(target: View, value: String) -> View { return style(target, CSSProperty.Border, value) }
const borderWidth = fn(target: View, value: String) -> View { return style(target, CSSProperty.BorderWidth, value) }
const borderColor = fn(target: View, value: String) -> View { return style(target, CSSProperty.BorderColor, value) }
const borderStyle = fn(target: View, value: String) -> View { return style(target, CSSProperty.BorderStyle, value) }
const borderTop = fn(target: View, value: String) -> View { return style(target, CSSProperty.BorderTop, value) }
const borderBottom = fn(target: View, value: String) -> View { return style(target, CSSProperty.BorderBottom, value) }
const borderCollapse = fn(target: View, value: String) -> View { return style(target, CSSProperty.BorderCollapse, value) }
const boxShadow = fn(target: View, value: String) -> View { return style(target, CSSProperty.BoxShadow, value) }
const opacity = fn(target: View, value: String) -> View { return style(target, CSSProperty.Opacity, value) }
const cursor = fn(target: View, value: String) -> View { return style(target, CSSProperty.Cursor, value) }
const pointerEvents = fn(target: View, value: String) -> View { return style(target, CSSProperty.PointerEvents, value) }
const overflow = fn(target: View, value: String) -> View { return style(target, CSSProperty.Overflow, value) }
const overflowX = fn(target: View, value: String) -> View { return style(target, CSSProperty.OverflowX, value) }
const verticalAlign = fn(target: View, value: String) -> View { return style(target, CSSProperty.VerticalAlign, value) }
const position = fn(target: View, value: String) -> View { return style(target, CSSProperty.Position, value) }
const top = fn(target: View, value: String) -> View { return style(target, CSSProperty.Top, value) }
const right = fn(target: View, value: String) -> View { return style(target, CSSProperty.Right, value) }
const bottom = fn(target: View, value: String) -> View { return style(target, CSSProperty.Bottom, value) }
const left = fn(target: View, value: String) -> View { return style(target, CSSProperty.Left, value) }
const zIndex = fn(target: View, value: String) -> View { return style(target, CSSProperty.ZIndex, value) }
const transition = fn(target: View, value: String) -> View { return style(target, CSSProperty.Transition, value) }
const transform = fn(target: View, value: String) -> View { return style(target, CSSProperty.Transform, value) }
const boxSizing = fn(target: View, value: String) -> View { return style(target, CSSProperty.BoxSizing, value) }
const aspectRatio = fn(target: View, value: String) -> View { return style(target, CSSProperty.AspectRatio, value) }
const animation = fn(target: View, value: String) -> View { return style(target, CSSProperty.Animation, value) }

# pseudoContent sets the CSS `content` property. Named for where it is
# usable rather than for the property: `content` only means anything on a
# ::before/::after pseudo-element, which an inline style can never be — so
# in practice this is only ever piped into a styles() template inside
# rule(), never onto a real View. The longer name also keeps it clear of
# `content`, which is this file's single most common parameter name.
const pseudoContent = fn(target: View, value: String) -> View { return style(target, CSSProperty.Content, value) }

# rtl/ltr/className/elementId are the modifiers in this file wrapping
# attr() instead of style() — "modifier" here just means "View -> View,
# pipeable," not "always CSS." Direction, class and id are HTML
# attributes, not style properties, so there's no CSSProperty member for
# any of them.
#
# className/elementId exist because inline styles (what style() and the
# whole modifier chain emit) genuinely cannot express everything: a
# :hover/:checked rule, a pseudo-element, a media query, or a keyframe
# animation all need a real stylesheet selector to attach to. Hooking one
# up means putting a class or id on the View — so these two are the bridge
# between a View tree and whatever stylesheet ships alongside it.
#
# elementId is named elementId, not id: a bare `id` is far too common a
# local variable name, and a local `let id = ...` shadowing a same-named
# top-level function in this module is exactly the collision that produces
# a confusing transpile failure rather than a clean shadow (the same
# reason option()'s second parameter is optionLabel, not label).
const rtl = fn(target: View) -> View { return attr(target, "dir", "rtl") }
const ltr = fn(target: View) -> View { return attr(target, "dir", "ltr") }
const className = fn(target: View, name: String) -> View { return attr(target, "class", name) }
const elementId = fn(target: View, value: String) -> View { return attr(target, "id", value) }

# ---------------------------------------------------------------------
# 5. Event handlers
#
# A View records a handler; it never attaches one. Which kind of handler
# you can use is decided by what will eventually walk the tree:
#
# A handler is JavaScript, built with @caja/js and emitted as an inline
# event attribute. The browser runs it; nothing of ours is involved at
# runtime, which is why it works in a page that has no Caja runtime in it —
# and a generated page never does.
#
# A Caja function cannot be a handler: there would be nothing in the page
# to call it. Read what you need from the DOM inside the script instead.
# ---------------------------------------------------------------------

# on() is private, and so is DOMEvent: the named onX wrappers are
# the whole public surface. The event is not a runtime choice — it is part
# of which function you called.
private const on = fn(target: View, event: DOMEvent, program: [JsStmt]) -> View {
	let v = target
	v.handlers = array.push(v.handlers, Handler{event: event, script: renderProgram(program)})
	return v
}

# ---------------------------------------------------------------------
# 5a. JavaScript event handlers
#
# One per event, 90 of them, each taking a @caja/js statement tree. This is
# what makes a static page interactive: renderToString has no Caja runtime
# to attach a Caja handler to, but it CAN emit JavaScript as an inline
# event attribute, which the browser then runs with nothing of ours
# involved at all.
#
#     button("Save") |> onClick([jsAlert(jsStr("saved"))])
#
# renders <button onclick='alert(&#39;saved&#39;)'>Save</button>. The
# attribute value goes through the ordinary attribute escaping, which is
# exactly right and needs no special case: a browser entity-decodes an
# attribute value before interpreting it as JavaScript, so the quotes
# arrive intact. (A <script> BODY is a different matter — see scriptBlock
# in section 8 and isRawText in section 6.)
#
# The parameter is a [JsStmt] — @caja/js's statement tree — not a string.
# That is what makes the JavaScript correct by construction rather than by
# hope: expressions and statements are separate types, every string is
# escaped on the way out, and the one node that can carry arbitrary syntax
# (jsRaw/jsRawStmt) holds a js.Script, which only js.raw produces and which
# js.raw obtains by actually parsing it at compile time.
#
#     onClick(btn, [jsAlert(jsStr("saved"))])
#     onClick(btn, [jsRawStmt(js.raw("alert('saved')"))])
#
# The first builds the call; the second embeds a validated literal. Both
# end up as the same attribute.
#
# Two limits worth knowing before reaching for these:
#   - The script cannot see anything from the Caja program. It is text sent
#     to a browser; nothing of yours is in scope there but the page itself.
#   - There is no event object plumbed through. An inline attribute can
#     reference `event` directly if you write it, but nothing here helps.
#
# The script cannot see anything from the Caja program that generated it:
# it is text sent to a browser. What it CAN do is be built from Caja values
# at build time, which is what @caja/js is for.
# ---------------------------------------------------------------------


# Mouse
const onClick = fn(target: View, program: [JsStmt]) -> View { return on(target, DOMEvent.Click, program) }
const onDoubleClick = fn(target: View, program: [JsStmt]) -> View { return on(target, DOMEvent.DoubleClick, program) }
const onAuxClick = fn(target: View, program: [JsStmt]) -> View { return on(target, DOMEvent.AuxClick, program) }
