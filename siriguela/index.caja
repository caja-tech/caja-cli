import * from "@caja/ui"
import array

# @caja/siriguela — the default theme for @caja/ui
#
# This package does NOT re-export @caja/ui Every name below is siriguela's
# own declaration: a palette, themed wrappers, the page/site model, the
# stylesheet that goes with it, and the higher-level building blocks a
# themed page is actually assembled from (docSection, componentDoc,
# heroPanel, ...). A consumer imports siriguela and writes siriguela; the
# structural layer is never reachable through this package.
#
# Why it is built this way rather than forwarding the structural catalog: a
# theme that forwards ~170 names is a theme in name only, and it makes
# every consumer's code depend on whether a given name happens to be
# forwarded. Composing instead means each name here is a decision — a
# `docSection` is a section with a heading, an anchor and a class, not a
# `section` you still have to assemble. @caja/ui stays reachable for
# anyone building their own theme; it just isn't reachable THROUGH this one.
#
# The structural layer arrives through a wildcard import, so everything in
# it is reached bare — values and types alike (`column(...)`, `x: View`).
# That still keeps "re-exports nothing" true: a wildcard import is
# deliberately NOT forwarded to the importing module's own consumers (only
# a named import is), so no @caja/ui name leaks through this package.
#
# The one rule that comes with a wildcard import: a same-named local
# declaration SILENTLY shadows the imported name — no "already declared"
# error the way a named import would give. So nothing in this file may
# declare a name @caja/ui already exports. A `const onClick` here, for
# instance, would shadow ui's and turn `return onClick(...)` into infinite
# self-recursion rather than the delegation it looks like. The export
# surfaces of the two packages must stay disjoint; that is checked, not
# assumed.

# ---------------------------------------------------------------------
# Palette
#
# Named after the fruit itself: a deep magenta skin, a warm orange flesh, a
# muted olive-green leaf, a pale cream background, a near-black ink, plus
# one semantic red the fruit doesn't stretch to. Plain Strings, not an
# enum: unlike CSSProperty these are meant to be re-pointed at other hex
# values by a theme of your own, which a closed enum would prevent.
# ---------------------------------------------------------------------

const siriguelaSkin = "#7A2048"
const siriguelaFlesh = "#F0A23A"
const siriguelaLeaf = "#6E8B3D"
const siriguelaCream = "#FBF3E6"
const siriguelaInk = "#2B1710"
const siriguelaDanger = "#B3261E"

private const paperColor = "#FFFDF8"
private const ruleColor = "#F0E6D6"
private const softInk = "#8A7A6D"
private const dashColor = "#E0D3C0"
private const codeWash = "#F6EFE3"

# ---------------------------------------------------------------------
# Prose and layout
#
# The small vocabulary every themed page is written in. Each one is a
# @caja/ui primitive plus this theme's spacing/typography decision — which
# is exactly the part a consumer should not have to repeat.
# ---------------------------------------------------------------------

const stack = fn(children: [View]) -> View {
	return column(children) |> gap("8px")
}

const pageContent = fn(children: [View]) -> View {
	return column(children) |> gap("48px")
}

const sectionBody = fn(children: [View]) -> View {
	return column(children) |> gap("16px")
}

const inlineRow = fn(children: [View]) -> View {
	return row(children) |> gap("12px") |> alignItems("center")
}

const paragraph = fn(content: String) -> View {
	return text(content)
}

const leadText = fn(content: String) -> View {
	return lead(content)
}

const mutedText = fn(content: String) -> View {
	return muted(content)
}

const sectionHeading = fn(content: String) -> View {
	return heading(2, content)
}

const subheading = fn(content: String) -> View {
	return heading(3, content)
}

const inlineCode = fn(content: String) -> View {
	return code(content)
}

const codeSample = fn(content: String) -> View {
	return codeBlock(content)
}

const divider = fn() -> View {
	return separator()
}

private const bulletItems = fn(items: [String]) -> [View] {
	if (array.len(items) == 0) {
		let none: [View] = []
		return none
	}
	let head = array.head(items)
	let one: [View] = [listItem(head)]
	return array.join(one, bulletItems(array.tail(items)))
}

const bulletList = fn(items: [String]) -> View {
	return unorderedList(bulletItems(items))
}

const guideSection = fn(title: String, items: [String]) -> View {
	let parts: [View] = [subheading(title), bulletList(items)]
	return stack(parts)
}

const imageBlock = fn(src: String, alt: String, size: String) -> View {
	return image(src, alt) |> width(size) |> height(size)
}

# ---------------------------------------------------------------------
# Themed components
# ---------------------------------------------------------------------

const primaryButton = fn(label: String) -> View {
	return button(label)
		|> backgroundColor(siriguelaSkin)
		|> color(siriguelaCream)
		|> padding("12px 20px")
		|> rounded("6px")
}

const secondaryButton = fn(label: String) -> View {
	return button(label)
		|> backgroundColor(siriguelaCream)
		|> color(siriguelaSkin)
		|> padding("12px 20px")
		|> rounded("6px")
}

const card = fn(children: [View]) -> View {
	return column(children)
		|> gap("8px")
		|> backgroundColor(siriguelaCream)
		|> padding("24px")
		|> rounded("12px")
}

const pageHeading = fn(content: String) -> View {
	return heading(1, content)
		|> color(siriguelaInk)
		|> fontFamily("system-ui, sans-serif")
}

const themedLink = fn(href: String, label: String) -> View {
	return link(href, label) |> color(siriguelaLeaf)
}

# Variant selects one palette color for the two components that vary by
# meaning. A closed enum, the same mechanism CSSProperty uses: an unknown
# variant is a compile-time error, not a typo that silently falls through.
enum Variant {
	Info = "info",
	Success = "success",
	Warning = "warning",
	Danger = "danger",
}

private const variantColor = fn(v: Variant) -> String {
	if (v == Variant.Success) {
		return siriguelaLeaf
	}
	if (v == Variant.Warning) {
		return siriguelaFlesh
	}
	if (v == Variant.Danger) {
		return siriguelaDanger
	}
	return siriguelaSkin
}

const themedAlert = fn(v: Variant, message: String) -> View {
	let accentColor = variantColor(v)
	let body: [View] = [text(message)]
	return alert(body)
		|> backgroundColor(siriguelaCream)
		|> color(accentColor)
		|> border("1px solid ${accentColor}")
		|> padding("12px 16px")
		|> rounded("6px")
}

const themedBadge = fn(v: Variant, badgeLabel: String) -> View {
	return badge(badgeLabel)
		|> backgroundColor(variantColor(v))
		|> color(siriguelaCream)
		|> padding("2px 8px")
		|> rounded("999px")
		|> fontSize("0.75rem")
}

const heroPanel = fn(imageSrc: String, imageAlt: String, title: String, subtitle: String) -> View {
	let copy: [View] = [heading(2, title), lead(subtitle)]
	let parts: [View] = [imageBlock(imageSrc, imageAlt, "96px"), column(copy)]
	return row(parts)
		|> gap("20px")
		|> alignItems("center")
		|> className("hero")
}

# ---------------------------------------------------------------------
# Documentation components
#
# The units a reference page is written in. docSection is the example
# case: a consumer wants "a section with a heading and an anchor", not a
# section() they then have to attach a heading, a gap, an id and a class
# to by hand.
# ---------------------------------------------------------------------

const docSection = fn(anchor: String, title: String, children: [View]) -> View {
	let parts: [View] = [sectionHeading(title), sectionBody(children)]
	return section(parts) |> elementId(anchor) |> className("doc-section")
}

const componentDoc = fn(names: String, summary: String, sample: String, demo: View) -> View {
	let parts: [View] = [
		code(names) |> className("sig"),
		muted(summary),
		codeBlock(sample),
		box(demo) |> className("demo")
	]
	return column(parts) |> className("component") |> gap("10px")
}

const tocLink = fn(anchor: String, linkText: String) -> View {
	return listItem("") |> addChild(link("#${anchor}", linkText))
}

const tocNav = fn(links: [View]) -> View {
	let list: [View] = [unorderedList(links)]
	return nav(list) |> className("toc")
}

const masthead = fn(title: String, tagline: String, badges: [View]) -> View {
	let parts: [View] = [pageHeading(title), lead(tagline), row(badges) |> gap("8px")]
	return header(parts) |> className("masthead")
}

const paletteRow = fn(name: String, hex: String) -> View {
	let swatch = view(HTMLElement.Span) |> className("swatch") |> backgroundColor(hex)
	let cells: [View] = [
		tableCell("") |> addChild(swatch),
		tableCell("") |> addChild(code(name)),
		tableCell(hex)
	]
	return tableRow(cells)
}

const paletteTable = fn(rows: [View]) -> View {
	let headCells: [View] = [
		tableHeaderCell(""),
		tableHeaderCell("Constant"),
		tableHeaderCell("Hex")
	]
	let head: [View] = [tableRow(headCells)]
	return table(array.join(head, rows))
}

const docTab = fn(id: String, label: String, content: View) -> Tab {
	return tab(id, label, content)
}

const docTabs = fn(groupName: String, items: [Tab]) -> View {
	return tabs(groupName, items) |> className("tabs")
}

# ---------------------------------------------------------------------
# The site chrome
#
# Page, definePage and navLinks live in @caja/ui, not here: a page with a
# title, an output path and some content — and a nav link that knows which
# page is current — are universal, with nothing theme-specific to decide.
# What IS this theme's decision is how that chrome LOOKS, which is all
# that remains below.
# ---------------------------------------------------------------------

# siteNav is ui's navLinks with this theme's class on it. The
# aria-current='page' marking (both the accessibility hint and the
# stylesheet's hook) comes from navLinks itself.
const siteNav = fn(pages: [Page], currentPath: String) -> View {
	return navLinks(pages, currentPath) |> className("site-nav")
}

private const siteFooter = fn(note: String) -> View {
	let parts: [View] = [
		separator(),
		muted(note),
		themedLink("https://www.cajalang.com", "cajalang.com")
	]
	return footer(parts) |> className("colophon")
}

# renderPage is the whole of "turn a Page into the file you write": the
# shared chrome (navigation, footer) plus the surrounding HTML document.
# It returns a String, never touching the filesystem — writing stays in
# the consuming project's main.caja, which is what keeps a program that
# imports this library runnable with `caja run`.
# pwaHead is the head content that makes a generated site installable: the
# manifest link, this theme's colour in the browser UI, and the iOS touch
# icon Safari needs because it ignores the manifest's own icons.
#
# Separate from renderPage so a consumer can drop it (a plain site that is
# not meant to be installable) or extend it, rather than having the theme
# decide on their behalf.
const pwaHead = fn() -> [View] {
	let items: [View] = [
		manifestLink("manifest.webmanifest"),
		themeColor(siriguelaSkin),
		appleTouchIcon("assets/icon-192.png")
	]
	return items
}

# renderPage turns a Page into the file you write: this theme's chrome
# (navigation, footer), the PWA head, and the service-worker registration,
# wrapped in a complete HTML document.
#
# The registration script goes last in the body so it runs after the page
# content exists, and it is JavaScript rather than anything of Caja's —
# there is no Caja runtime in a generated page.
const renderPage = fn(current: Page, all: [Page], footerNote: String, stylesheetHref: String) -> String {
	let shell: [View] = [
		header([siteNav(all, current.path)]),
		current.content,
		siteFooter(footerNote)
	]
	let body: [View] = [
		mainEl(shell) |> className("page"),
		scriptBlock(serviceWorkerRegistration("sw.js"))
	]
	return htmlDocument(current.title, stylesheetHref, pwaHead(), body)
}

# ---------------------------------------------------------------------
# The stylesheet
#
# A theme owns its stylesheet. siriguela emits inline styles for anything
# a single element can carry; everything selector-based — hover states,
# checked siblings, media queries, the classes the components above attach
# — lives here, written in Caja rather than as a hand-written CSS string,
# so a misspelled property is still a compile-time error.
#
# The tabs/toggle selectors use the child combinator deliberately: tabs()
# puts its radios, labels and panel wrapper as DIRECT children of its own
# root, and a descendant selector would also catch the radio and checkbox
# demos living INSIDE a tab panel and render them invisible.
# ---------------------------------------------------------------------

private const baseRules = fn() -> [Rule] {
	let rules: [Rule] = [
		rule("*, *::before, *::after", styles() |> boxSizing("border-box")),
		rule("body", styles()
			|> margin("0")
			|> background(paperColor)
			|> color(siriguelaInk)
			|> fontFamily("system-ui, -apple-system, Segoe UI, sans-serif")
			|> lineHeight("1.6")),
		rule(".page", styles()
			|> display("flex")
			|> flexDirection("column")
			|> gap("40px")
			|> maxWidth("860px")
			|> margin("0 auto")
			|> padding("32px 20px 96px")),
		rule("h1, h2, h3", styles() |> lineHeight("1.25") |> margin("0")),
		rule("h2", styles()
			|> fontSize("1.6rem")
			|> paddingBottom("8px")
			|> borderBottom("2px solid ${ruleColor}")),
		rule("h3", styles() |> fontSize("1.05rem") |> marginTop("8px")),
		rule("p", styles() |> margin("0")),
		rule("a", styles() |> color(siriguelaLeaf)),
		rule("hr", styles()
			|> border("0")
			|> borderTop("1px solid ${ruleColor}")
			|> width("100%")
			|> margin("8px 0")),
		rule("code", styles()
			|> fontFamily("ui-monospace, SFMono-Regular, Menlo, monospace")
			|> fontSize("0.875em")
			|> background(codeWash)
			|> padding("2px 6px")
			|> rounded("4px")),
		rule("pre", styles()
			|> margin("0")
			|> background(siriguelaInk)
			|> color(siriguelaCream)
			|> padding("14px 16px")
			|> rounded("8px")
			|> overflowX("auto")),
		rule("pre code", styles()
			|> background("none")
			|> color("inherit")
			|> padding("0")
			|> fontSize("0.85rem")
			|> lineHeight("1.55")),
		rule("table", styles() |> borderCollapse("collapse") |> width("100%")),
		rule("th, td", styles()
			|> textAlign("left")
			|> padding("8px 10px")
			|> borderBottom("1px solid ${ruleColor}")
			|> verticalAlign("middle")),
		rule("th", styles()
			|> fontSize("0.8rem")
			|> textTransform("uppercase")
			|> letterSpacing("0.04em")
			|> color(softInk)),
		rule("summary", styles() |> cursor("pointer") |> fontWeight("600") |> padding("8px 0")),
		rule("details", styles() |> borderBottom("1px solid ${ruleColor}")),
		rule("[popover]", styles()
			|> border("1px solid ${dashColor}")
			|> rounded("10px")
			|> padding("16px")
			|> boxShadow("0 12px 32px #2b171022"))
	]
	return rules
}

private const chromeRules = fn() -> [Rule] {
	let rules: [Rule] = [
		rule(".site-nav", styles()
			|> display("flex")
			|> gap("18px")
			|> flexWrap("wrap")
			|> paddingBottom("12px")
			|> borderBottom("1px solid ${ruleColor}")),
		rule(".site-nav a", styles()
			|> color(softInk)
			|> textDecoration("none")
			|> fontWeight("600")
			|> padding("4px 0")),
		rule(".site-nav a[aria-current=page]", styles()
			|> color(siriguelaSkin)
			|> borderBottom("2px solid ${siriguelaSkin}")),
		rule(".masthead", styles() |> gap("10px")),
		rule(".colophon", styles() |> gap("8px") |> marginTop("16px")),
		rule(".toc", styles()
			|> background(siriguelaCream)
			|> rounded("10px")
			|> padding("16px 18px")),
		rule(".toc ul", styles() |> margin("0") |> padding("0 0 0 18px")),
		rule(".doc-section", styles()
			|> display("flex")
			|> flexDirection("column")
			|> gap("16px")),
		rule(".component", styles()
			|> border("1px solid ${ruleColor}")
			|> rounded("10px")
			|> padding("18px")
			|> background("#FFFFFF")),
		rule(".demo", styles()
			|> marginTop("4px")
			|> border("1px dashed ${dashColor}")
			|> rounded("8px")
			|> padding("16px")
			|> background(paperColor)),
		rule(".sig", styles()
			|> display("inline-block")
			|> background(siriguelaSkin)
			|> color(siriguelaCream)
			|> fontSize("0.85rem")),
		rule(".pill", styles()
			|> background(siriguelaLeaf)
			|> color(siriguelaCream)
			|> padding("2px 10px")
			|> rounded("999px")
			|> fontSize("0.75rem")),
		rule(".swatch", styles()
			|> display("block")
			|> width("22px")
			|> height("22px")
			|> rounded("6px")
			|> border("1px solid #00000018"))
	]
	return rules
}

private const interactiveRules = fn() -> [Rule] {
	let rules: [Rule] = [
		rule(".tabs > input[type=radio]", styles()
			|> position("absolute")
			|> opacity("0")
			|> pointerEvents("none")),
		rule(".tabs > label", styles()
			|> display("inline-block")
			|> cursor("pointer")
			|> padding("8px 14px")
			|> rounded("8px 8px 0 0")
			|> fontSize("0.9rem")
			|> color(softInk)),
		rule(".tabs > input[type=radio]:checked + label", styles()
			|> background(siriguelaSkin)
			|> color(siriguelaCream)),
		rule(".tabs > div[id^=panels-]", styles()
			|> borderTop("2px solid ${siriguelaSkin}")
			|> paddingTop("20px")
			|> marginTop("-1px")),
		rule("span > input[type=checkbox]", styles()
			|> position("absolute")
			|> opacity("0")
			|> pointerEvents("none")),
		rule("span > input[type=checkbox] + label", styles()
			|> display("inline-block")
			|> cursor("pointer")
			|> border("1px solid ${dashColor}")
			|> rounded("6px")
			|> padding("6px 12px")
			|> fontSize("0.9rem")),
		rule("span > input[type=checkbox]:checked + label", styles()
			|> background(siriguelaSkin)
			|> color(siriguelaCream)
			|> borderColor(siriguelaSkin))
	]
	return rules
}

# heroClass is a Class rather than a plain rule because it carries a
# :hover variant — the one thing an inline style can never express.
private const heroClass = fn() -> Class {
	let base = class("hero", styles()
		|> padding("24px")
		|> rounded("12px")
		|> backgroundColor(siriguelaCream)
		|> transition("box-shadow 0.2s ease"))
	return variant(base, "hover", styles() |> boxShadow("0 8px 24px #7a204833"))
}

private const responsiveQueries = fn() -> [MediaQuery] {
	let narrow: [Rule] = [
		rule(".page", styles() |> padding("24px 16px 64px") |> gap("28px")),
		rule("pre", styles() |> fontSize("0.8rem")),
		rule(".component", styles() |> padding("14px"))
	]
	let queries: [MediaQuery] = [media("(max-width: 640px)", narrow)]
	return queries
}

# siteStylesheet is the whole of this theme's CSS, ready to write to a
# .css file. Everything a siriguela page needs a selector for is in here,
# so a consuming project has no hand-written CSS at all.
const siteStylesheet = fn() -> String {
	let rules: [Rule] = baseRules() |> array.join(chromeRules()) |> array.join(interactiveRules())
	let classes: [Class] = [heroClass()]
	let queries: [MediaQuery] = responsiveQueries()
	# No @keyframes of its own yet: this theme animates nothing that a
	# transition can't express. @caja/ui's own animated components
	# (skeleton, spinner) expose their keyframes as pulseKeyframes()/
	# spinKeyframes(), so a theme that uses them adds them to this list
	# rather than shipping ui's <style> blocks per page.
	let frames: [Keyframes] = []
	return stylesheet(frames, rules, classes, queries)
}
