const onMouseLeave = fn(target: View, handler: fn() -> Nothing) -> View { return on(target, DOMEvent.MouseLeave, handler) }
const onMouseOver = fn(target: View, handler: fn() -> Nothing) -> View { return on(target, DOMEvent.MouseOver, handler) }
