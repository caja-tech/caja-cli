{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "caja",
  "scopeName": "source.caja",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "#.*", "name": "comment.line.number-sign.caja" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.caja",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.caja" }]
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(import|as|return|if|else|and|or|xor)\\b", "name": "keyword.control.caja" },
        { "match": "\\b(let|const|fn|struct|type|private)\\b", "name": "storage.type.caja" }
      ]
    },
    "constants": {
      "patterns": [
        { "match": "\\b(true|false|nil)\\b", "name": "constant.language.caja" }
      ]
    },
    "types": {
      "patterns": [
        { "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b", "name": "entity.name.type.caja" }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b\\d+(\\.\\d+)?\\b", "name": "constant.numeric.caja" }
      ]
    },
    "functions": {
      "patterns": [
        { "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()", "name": "entity.name.function.caja" }
      ]
    },
    "operators": {
      "patterns": [
        { "match": "(->|\\?\\.|==|!=|<=|>=|<|>|=|\\+|-|\\*|/)", "name": "keyword.operator.caja" }
      ]
    }
  }
}
