import map

type CustomStruct struct {
	key map.KeyFunc
	value String
}

let run_test = fn() -> Number {
	let s = CustomStruct {
		key: fn() -> String { return "" },
		value: "key"
	}

	s.key = fn() -> String { return s.value }

	let d: map[CustomStruct]Number = {}
	d[s] = 10

	return d[s]
}

return run_test()
