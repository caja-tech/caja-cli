let makeGreeting = fn(name: String, greeting: String) -> String {
	return "${greeting}, ${name}"
}

let identity = fn<T>(value: T) -> T {
	return value
}

let onlyNamed = makeGreeting(name: "Ana", greeting: "Hello")
let mixed = makeGreeting("Bob", greeting: "Hi")
let reordered = makeGreeting(greeting: "Hey", name: "Carl")
let piped = "Dee" |> makeGreeting(greeting: "Yo")
let generic = identity(value: 42)

if (onlyNamed != "Hello, Ana") {
	return 1
}

if (mixed != "Hi, Bob") {
	return 1
}

if (reordered != "Hey, Carl") {
	return 1
}

if (piped != "Yo, Dee") {
	return 1
}

if (generic != 42) {
	return 1
}

return 0
