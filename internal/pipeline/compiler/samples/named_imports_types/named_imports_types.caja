import { Circle, Square, Shape, BigCircle, Size } from "./shapes"
import { Client } from "http"

let c: Circle = Circle { radius: 5 }
let s: Shape = c
let matched: Circle? = s is Circle
let big: BigCircle? = Circle { radius: 20 }

let useClient = fn(client: Client) -> Client {
	return client
}

# Size is a named-imported enum: classify's parameter exercises the TYPE
# form (Size resolving as a type annotation) and Size.Small exercises the
# VALUE form (an enum's name is registered in both, unlike Circle/Shape/
# BigCircle above, which only ever exist as types).
let classify = fn(size: Size) -> Number {
	if (size == Size.Small) {
		return 1
	}
	return 2
}

if (matched == nil) {
	return 1
}

if (big == nil) {
	return 1
}

if (classify(Size.Small) != 1) {
	return 1
}

return 0
